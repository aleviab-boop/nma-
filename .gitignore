# Secrets — NEVER commit
.env
.env.*
!.env.example

# Vercel deploy config — contains an API token, must NOT be committed
deploy.config.json

# Local dev state — generated by dev_server.py /api/state shim
.dev_state.json
.dev_state.json.tmp

# Backup snapshots
*.bak
*.bak.*

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp

# Node (in case you add a build step later)
node_modules/

# Vercel
.vercel/

# Logs
*.log
